{
  "name": "on-chain-arbitrage",
  "version": "0.1.0",
  "private": true,
  "description": "On-Chain Arbitrage Lab — research, backtesting and automated execution platform for on-chain arbitrage.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "migrate:pg": "node scripts/migrate-postgres.mjs",
    "search:candidates": "node scripts/search-high-apy-strategies.mjs",
    "search:dex-arb": "node scripts/search-dex-arbitrage-candidates.mjs",
    "search:liquidations": "node scripts/search-aave-liquidations.mjs",
    "search:spark-liquidations": "LIQ_CHAIN=spark-ethereum node scripts/search-aave-liquidations.mjs",
    "watch:aave-liquidations": "node scripts/build-aave-liquidation-watchlist.mjs",
    "analyze:aave-watchlist": "node scripts/build-aave-watchlist-analysis.mjs",
    "search:compound-liquidations": "node scripts/search-compound-v3-liquidations.mjs",
    "replay:compound-liquidations": "node scripts/replay-compound-v3-liquidation-events.mjs",
    "search:morpho-liquidations": "node scripts/search-morpho-blue-liquidations.mjs",
    "replay:morpho-liquidations": "node scripts/replay-morpho-blue-liquidation-events.mjs",
    "watch:morpho-liquidations": "node scripts/build-morpho-blue-liquidation-watchlist.mjs",
    "search:curve-stable-arb": "node scripts/search-curve-stable-arbitrage.mjs",
    "search:balancer-arb": "node scripts/search-balancer-arbitrage-candidates.mjs",
    "search:uniswap-v3-fee-arb": "node scripts/search-uniswap-v3-fee-arbitrage.mjs",
    "search:pendle-pt-arb": "node scripts/search-pendle-pt-arbitrage.mjs",
    "search:maker-clipper": "node scripts/search-maker-clipper-auctions.mjs",
    "replay:aave-liquidations": "node scripts/replay-aave-liquidation-events.mjs",
    "replay:spark-liquidations": "AAVE_REPLAY_CHAIN=spark-ethereum node scripts/replay-aave-liquidation-events.mjs",
    "build:strategy-atlas": "node scripts/build-strategy-family-atlas.mjs",
    "search:pure-overview": "node scripts/run-pure-arbitrage-search.mjs",
    "refresh:live-opportunities": "node scripts/refresh-live-opportunities.mjs",
    "build:market-depth": "node scripts/build-market-depth-snapshots.mjs",
    "build:live-opportunity-feed": "node scripts/build-live-opportunity-feed.mjs",
    "node:scanner": "node scripts/run-arbitrage-node.mjs scanner",
    "node:executor": "node scripts/run-arbitrage-node.mjs executor",
    "verify:live-fork-candidates": "node scripts/verify-live-fork-candidates.mjs",
    "smoke:pure-live-interfaces": "node scripts/smoke-pure-live-interfaces.mjs",
    "smoke:aave-fork-calldata": "node scripts/smoke-aave-fork-calldata-report.mjs",
    "record:aave-executor-deployment": "node scripts/record-aave-executor-deployment.mjs",
    "record:compound-v3-executor-deployment": "node scripts/record-compound-v3-executor-deployment.mjs",
    "record:morpho-blue-executor-deployment": "node scripts/record-morpho-blue-executor-deployment.mjs",
    "record:wallet-arb-executor-deployment": "node scripts/record-wallet-arb-executor-deployment.mjs",
    "replay:lp-fees": "node scripts/replay-uniswap-v3-lp-fees.mjs",
    "seed:reference": "node scripts/seed-reference-data.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  }
}
