# =============================================================================
# On-Chain Arbitrage Lab — environment configuration template.
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.
#
# Per full-audit plan §1.4 (Phase 0):
# - NO default admin keys or private keys that work in non-local environments.
# - Every secret below MUST be overridden before any non-Anvil deployment.
# - `LIVE_EXECUTION_ENABLED` defaults to false; do not flip until Phase 4 done.
# =============================================================================

# ---- EVM RPC endpoints (archive nodes required for backtesting/forking) ----
# Primary endpoints. Provide at least one per chain you operate on.
# Archive capability is REQUIRED for historical replay (eth_call at old blocks).
RPC_ETHEREUM_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_ARBITRUM_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_OPTIMISM_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BNB_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_LOCAL_URL=http://127.0.0.1:8545

# Backup RPC endpoints (optional). Phase 0 §3 requires >= 2 RPCs per chain
# with automatic failover. Leave empty to disable failover for a chain.
RPC_ETHEREUM_URL_BACKUP=
RPC_ARBITRUM_URL_BACKUP=
RPC_BASE_URL_BACKUP=
RPC_POLYGON_URL_BACKUP=

# RPC health thresholds. A chain is marked unhealthy if latency exceeds this
# or if error rate in the last window exceeds the threshold.
RPC_MAX_LATENCY_MS=5000
RPC_ERROR_RATE_THRESHOLD=0.1

# ---- Transaction signer (LIVE EXECUTION ONLY — HIGH RISK) -------------------
# Dedicated executor EOA. NEVER use a main holding wallet. NEVER commit.
# Leave BLANK unless LIVE_EXECUTION_ENABLED=true and Phase 4 is complete.
EXECUTOR_PRIVATE_KEY=
# Address of the deployed StrategyExecutor contract per chain (Phase 6).
EXECUTOR_ADDRESS_ETHEREUM=
EXECUTOR_ADDRESS_ARBITRUM=
EXECUTOR_ADDRESS_BASE=
EXECUTOR_ADDRESS_POLYGON=

# ---- Live execution kill switch ---------------------------------------------
# Master switch. Must be explicitly "true" for any real submission.
# Default false — all execution paths fail closed when unset/non-true.
LIVE_EXECUTION_ENABLED=false
# Per-strategy and global daily-loss caps (asset base units). 0 = disabled.
GLOBAL_DAILY_LOSS_CAP_USD=0
STRATEGY_DAILY_LOSS_CAP_USD=0
# Auto-pause after N consecutive on-chain failures.
MAX_CONSECUTIVE_FAILURES=3

# ---- MEV / private relay endpoints (Phase 4) --------------------------------
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
BEAVERBUILD_RELAY_URL=https://rpc.beaverbuild.org
TITAN_RELAY_URL=https://rpc.titanbuilder.xyz
# Builder tip as fraction of gross profit (e.g. 0.30 = 30%).
BUILDER_TIP_FRACTION=0.30

# ---- Deployed contract addresses (fill after Phase 6 deployment) ------------
# Leave empty in research/Phase 0. Populated per chain after testnet/mainnet deploy.
ARB_VAULT_ADDRESS=
STRATEGY_CONTROLLER_ADDRESS=
RISK_MANAGER_ADDRESS=
ACCOUNTING_ADDRESS=
TIMELOCK_ADDRESS=

# ---- Databases --------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=oal
POSTGRES_USER=oal
# CHANGE THIS for anything beyond local docker-compose dev.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgres://oal:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/oal

# Timescale lives in the same Postgres instance (TimescaleDB extension).
TIMESCALE_URL=postgres://oal:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/oal

REDIS_URL=redis://127.0.0.1:6379

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=oal
# CHANGE THIS for anything beyond local dev.
CLICKHOUSE_PASSWORD=CHANGE_ME_LOCAL_ONLY
CLICKHOUSE_URL=http://oal:CHANGE_ME_LOCAL_ONLY@127.0.0.1:8123/oal

# ---- API gateway ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# MUST be a strong random string in any non-local env. Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=GENERATE_WITH_openssl_rand_hex_32

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=info
# Sentry DSN (optional)
SENTRY_DSN=
# Prometheus metrics endpoint
METRICS_PORT=9091
